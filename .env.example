# ---------- API (apps/api) ----------
NODE_ENV=development
PORT=4000
# Local: docker compose. Production: managed PostGIS connection string (never commit).
DATABASE_URL=postgresql://parkflow:parkflow_dev@localhost:5432/parkflow
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
# Nominatim requires an identifying User-Agent / contact
GEOCODER_USER_AGENT=ParkFlow/0.1 (contact@example.com)

# ---------- Web (apps/web) ----------
VITE_API_URL=http://localhost:4000

# ---------- ML service (ml) ----------
MODEL_REGISTRY_PATH=ml/artifacts/registry.json
